#!/usr/bin/env bash
# Pre-push gate for obsidian-dgmo (#762): the checks below run on the PUSHED COMMIT,
# in a throwaway worktree, before anything reaches the remote.
#
# Same shape as dgmo's and the app's gates — read dgmo/.githooks/pre-push for
# the incidents behind each piece. In short:
#
#   * The pushed commit, never the working tree. Ten sessions share these
#     checkouts, so the tree is routinely mid-edit by somebody else, and a gate
#     that reads it refuses pushes for files that are not in them (#445, #534).
#   * The worktree is a DIRECT child of ~/code/diagrammo, because scripts here
#     and in the siblings resolve `../dgmo`, `../dgmo-content` and friends; a
#     gate in TMPDIR reads nothing there and fails as if a fixture were missing.
#     Outside the workspace (a lone clone) it falls back to TMPDIR.
#   * One gate at a time across the workspace (scripts/gate-lock.sh, #557), and
#     a leaked worktree is collected by scripts/gate-sweep.sh via .gate-owner.
#   * It prints `pre-push: gating a worktree at <short>` BEFORE checking
#     anything. The nightly run's survey and push record read that line as the
#     only proof a gate ran; a silent hook and no hook look identical.
#
# Armed by the `prepare` script (`git config core.hooksPath .githooks`), so
# `pnpm install` switches it on. Never bypass it with --no-verify.

# git exports GIT_DIR and friends into every hook, and `git worktree add` and
# anything the checks shell out to would resolve against it.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_OBJECT_DIRECTORY GIT_ALTERNATE_OBJECT_DIRECTORIES

set -eu

REPO=obsidian-dgmo

# The checks, in CI's order where CI exists, cheapest first otherwise.
# Runs inside the gate worktree.
run_checks() {
  # CI runs no tests here; the gate adds them.
  echo "→ install (frozen)"
  pnpm install --frozen-lockfile --prefer-offline --reporter=silent || {
    echo "✗ frozen install failed — the lockfile no longer matches package.json" >&2
    return 1
  }

  echo "→ hygiene (check:all)"
  pnpm check:all

  echo "→ typecheck"
  pnpm typecheck

  echo "→ lint"
  pnpm lint

  echo "→ format"
  pnpm format:check

  echo "→ test"
  pnpm test

  echo "→ build"
  pnpm build
}

ZERO=0000000000000000000000000000000000000000
REPO_ROOT=$(git rev-parse --show-toplevel)
WORKSPACE=$(dirname "$REPO_ROOT")

# "<local ref> <local sha> <remote ref> <remote sha>" per ref, readable once.
refs=$(cat)

pushed=$(printf '%s\n' "$refs" | awk -v z="$ZERO" '$2 != "" && $2 != z { print $2 }' | sort -u)
tags=$(printf '%s\n' "$refs" | awk -v z="$ZERO" '$1 ~ /^refs\/tags\// && $2 != z { print $1 }')

if [ -z "$pushed" ]; then
  echo "pre-push: nothing to gate (no commits in this push)"
  exit 0
fi

GATE_LOCK="$WORKSPACE/scripts/gate-lock.sh"
GATE_SWEEP="$WORKSPACE/scripts/gate-sweep.sh"
if [ -x "$GATE_SWEEP" ]; then GATE_PARENT=$WORKSPACE; else GATE_PARENT=${TMPDIR:-/tmp}; fi

gate=
cleanup() {
  if [ -x "$GATE_LOCK" ]; then "$GATE_LOCK" release $$ || true; fi
  [ -n "$gate" ] || return 0
  git -C "$REPO_ROOT" worktree remove --force "$gate" >/dev/null 2>&1 || true
  rm -rf "$gate"
  git -C "$REPO_ROOT" worktree prune >/dev/null 2>&1 || true
  gate=
}
trap cleanup EXIT INT TERM

if [ -x "$GATE_SWEEP" ]; then "$GATE_SWEEP" || true; fi
if [ -x "$GATE_LOCK" ]; then "$GATE_LOCK" acquire "$REPO" $$ || true; fi

for sha in $pushed; do
  short=$(git rev-parse --short "$sha")
  echo "pre-push: gating a worktree at $short"
  gate=$(mktemp -d "$GATE_PARENT/.gate-pkg.$REPO.XXXXXX")
  git -C "$REPO_ROOT" worktree add --detach --quiet "$gate" "$sha"
  echo $$ > "$gate/.gate-owner"
  # A plain subshell, not `( … ) || …`: errexit is switched off for anything
  # on the left of `||`, so every check would run and a failure would pass.
  set +e
  ( cd "$gate" || exit 1; set -e; run_checks )
  rc=$?
  set -e
  if [ "$rc" -ne 0 ]; then
    echo "pre-push: REFUSED at $short — a check above failed" >&2
    exit "$rc"
  fi
  cleanup
done
